# Base URL of the Switch Fiber backend API.
# Used by the Vite dev proxy (vite.config.js). In production the /api path is
# rewritten by vercel.json instead.
VITE_API_URL=https://your-api-host:8090

# Optional: point the axios client straight at an API origin instead of the
# same-origin /api path. Leave unset to use the proxy/rewrite.
# VITE_API_BASE_URL=
